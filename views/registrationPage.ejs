<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registration</title>
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="flex items-center justify-center min-h-screen bg-hush">

  <div class="bg-white w-11/12 rounded-xl shadow-lg md:w-3/4 lg:w-2/3">

    <h1 class="text-center text-xl font-semibold p-4">
      Registration
    </h1>

    <form action="/register" method="POST" class="flex flex-col p-6 gap-1">

      <label for="fullname">Full Name</label>
      <input id="fullname" name="fullname" type="text" placeholder="John Doe" class="h-10 rounded-md px-3 border">

      <label for="email">Email Address</label>
      <input id="email" name="email" type="email" placeholder="john@example.com" class="h-10 rounded-md px-3 border">

      <label for="rollNumber">Registration Number</label>
      <input id="rollNumber" name="rollNumber" type="text" placeholder="23ACSE113" class="h-10 rounded-md px-3 border">

      <label for="yearOfStudy">Year of Study</label>
      <input id="yearOfStudy" name="yearOfStudy" type="number" placeholder="1 - 4" class="h-10 rounded-md px-3 border">

      <label for="semester">Semester</label>
      <input id="semester" name="semester" type="number" placeholder="1 or 2" class="h-10 rounded-md px-3 border">

      <label for="branch">Branch</label>
      <input id="branch" name="branch" type="text" placeholder="CSE" class="h-10 rounded-md px-3 border">

      <label for="section">Section</label>
      <input id="section" name="section" type="text" placeholder="A/B/C/D" class="h-10 rounded-md px-3 border">

      <label for="password">Password</label>
      <input id="password" name="password" type="password" placeholder="********" class="h-10 rounded-md px-3 border">

      <button
        class="bg-blue-500 text-white font-semibold rounded-md p-2 w-fit mx-auto mt-3 hover:bg-blue-600 transition">
        Register
      </button>

    </form>

  </div>

</body>

</html>