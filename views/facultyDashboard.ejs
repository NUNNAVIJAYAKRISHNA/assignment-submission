<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faculty Dashboard - AssignHub</title>
  <link rel="stylesheet" href="/css/output.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
  </style>
  <script>
    function toggleClass(index) {
      const element = document.getElementById("class-" + index);
      const chevron = document.getElementById("chevron-" + index);
      if (element.style.display === "none") {
        element.style.display = "block";
        if (chevron) {
          chevron.classList.add("rotate-180");
        }
      } else {
        element.style.display = "none";
        if (chevron) {
          chevron.classList.remove("rotate-180");
        }
      }
    }
  </script>
</head>

<body class="min-h-screen bg-hush text-slate-800 flex flex-col">

  <!-- Navbar -->
  <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center space-x-3">
          <!-- Logo could go here -->
        </div>
        <div class="flex items-center space-x-4">
          <a href="/"
            class="text-sm font-semibold text-slate-600 hover:text-indigo-600 transition-colors duration-200">Home</a>
          <span class="h-4 w-px bg-slate-200"></span>
          <a href="/login"
            class="inline-flex items-center space-x-1.5 text-sm font-semibold text-rose-600 hover:text-rose-700 transition-colors duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
              stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Logout</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">

    <!-- Hero / Profile Header Section -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-indigo-950 via-slate-900 to-violet-950 text-white p-6 sm:p-8 lg:p-10 shadow-2xl mb-8">
      <!-- Decorative circles -->
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl"></div>
      <div class="absolute -right-32 -bottom-32 w-96 h-96 bg-violet-500/10 rounded-full blur-3xl"></div>

      <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="flex items-center space-x-4 sm:space-x-6">
          <div class="flex-shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-3xl font-bold text-indigo-300 shadow-inner">
            <%= user.fullname.charAt(0).toUpperCase() %>
          </div>
          <div>
            <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 mb-2">
              Faculty Profile
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Welcome, <%= user.fullname %></h1>
            <p class="text-slate-300 mt-1 flex flex-wrap gap-x-4 text-sm sm:text-base">
              <% if(user.designation) { %>
                <span>Designation: <strong class="text-white"><%= user.designation %></strong></span>
              <% } %>
            </p>
          </div>
        </div>

        <!-- Stats Grid (Inside Hero) -->
        <div class="grid grid-cols-2 gap-4 md:w-auto w-full border-t border-white/10 pt-6 md:pt-0 md:border-t-0">
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-4 min-w-[120px] text-center md:text-left">
            <p class="text-xs text-indigo-300 font-medium tracking-wide uppercase">Assigned Classes</p>
            <p class="text-2xl font-bold mt-1 text-white"><%= studentList.length %></p>
          </div>
          <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-4 min-w-[120px] text-center md:text-left">
            <p class="text-xs text-indigo-300 font-medium tracking-wide uppercase">Total Students</p>
            <p class="text-2xl font-bold mt-1 text-white">
              <%= studentList.reduce((acc, cls) => acc + cls.students.length, 0) %>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Classes Section -->
    <div class="space-y-6">
      <div>
        <h2 class="text-xl font-bold text-slate-900 tracking-tight">Your Classes</h2>
        <p class="text-sm text-slate-500 mt-0.5">Manage your assigned classes, view student directories, and check assignments.</p>
      </div>

      <% if(studentList.length === 0) { %>
        <!-- Empty State -->
        <div class="bg-white border border-slate-100 rounded-3xl p-12 text-center shadow-sm">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 text-slate-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
              stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-800">No Classes Assigned</h3>
          <p class="text-slate-500 max-w-sm mx-auto mt-2 text-sm">We couldn't find any student lists assigned to your account. Please reach out to your system administrator.</p>
        </div>
      <% } else { %>
        <!-- Classes List -->
        <div class="space-y-4">
          <% studentList.forEach((cls, index)=> { %>
            <div class="border border-slate-100 bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
              
              <!-- Accordion Header -->
              <div class="flex items-center justify-between p-5 bg-slate-50/50 hover:bg-slate-50 cursor-pointer border-b border-slate-100 transition-colors duration-200 select-none" 
                   data-index="<%= index %>" onclick="toggleClass(this.dataset.index)">
                <div class="flex items-center space-x-4">
                  <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-extrabold text-sm">
                    Y<%= cls.year %>
                  </div>
                  <div>
                    <h3 class="font-bold text-slate-900 text-sm sm:text-base">Year <%= cls.year %> — Section <%= cls.section %></h3>
                    <p class="text-xs text-slate-400 font-medium">Student Directory</p>
                  </div>
                </div>

                <div class="flex items-center space-x-3">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700">
                    <%= cls.students.length %> students
                  </span>
                  <svg id="chevron-<%= index %>" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400 transform transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>

              <!-- Accordion Body -->
              <div id="class-<%= index %>" class="transition-all duration-300" style="display: none;">
                <% if (cls.students.length === 0) { %>
                  <div class="p-6 text-center text-slate-400 text-sm">
                    No students registered in this section yet.
                  </div>
                <% } else { %>
                  <div class="divide-y divide-slate-100 max-h-96 overflow-y-auto">
                    <% cls.students.forEach(student => { %>
                      <div class="flex items-center justify-between p-4 sm:px-6 hover:bg-slate-50/40 transition-colors">
                        <div class="flex items-center space-x-3">
                          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-50 to-violet-50 text-indigo-600 flex items-center justify-center text-xs font-bold shadow-inner">
                            <%= student.fullname.charAt(0).toUpperCase() %>
                          </div>
                          <div>
                            <span class="text-sm font-semibold text-slate-800"><%= student.fullname %></span>
                            <span class="text-xs text-slate-400 block sm:inline sm:ml-3">Reg No: <strong class="text-slate-600 font-medium"><%= student.rollNumber %></strong></span>
                          </div>
                        </div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                          Enrolled
                        </span>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>

            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>

  <footer class="py-8 text-center text-xs text-slate-400 mt-auto">
    <p>&copy; 2026 AssignHub. All rights reserved.</p>
  </footer>

</body>

</html>