<!DOCTYPE html>
<html lang="en">

<head>
  <title>Login</title>
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="flex items-center justify-center min-h-screen bg-hush">

  <div class="bg-white p-6 rounded-xl shadow-lg w-80">

    <h1 class="text-center text-xl font-semibold mb-4">Login</h1>

    <form action="/login" method="POST" class="flex flex-col gap-2">

      <label>Email</label>
      <input name="email" type="email" class="border rounded-md px-3 h-10">

      <label>Password</label>
      <input name="password" type="password" class="border rounded-md px-3 h-10">

      <button class="bg-blue-500 text-white p-2 rounded-md mt-2">
        Login
      </button>

    </form>

  </div>

</body>

</html>