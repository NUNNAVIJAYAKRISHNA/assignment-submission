<h2>Welcome <%= user.fullname %>
</h2>

<p>
  Year: <%= user.yearOfStudy %>
</p>

<p>
  Section: <%= user.section %>
</p>


<h3>Your Faculty</h3>

<table border="1">

  <tr>
    <th>Faculty</th>
    <th>Subject</th>
    <th>Submit</th>
  </tr>


  <% facultyList.forEach(faculty=> {

    const matchedTeaching = faculty.teaching.find(t =>
    t.year === user.yearOfStudy &&
    t.section === user.section
    );

    %>

    <tr>

      <td>

        <%= faculty.fullname %>

      </td>

      <td>

        <%= matchedTeaching.subject %>

      </td>

      <td>

        <a href="/submit-video/<%= faculty._id %>">

          <button>

            Submit Video Assignment

          </button>

        </a>

      </td>

    </tr>

    <% }) %>

</table>